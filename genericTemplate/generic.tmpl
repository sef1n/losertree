package generic

import (
	"fmt"
	"strings"
)

// leafGTYPE is a participant of a [LoserTreeGTYPE].
//
// After reading the winner, the caller must update the
// winning leafGTYPE via Upd or Kill, then call Pop to re-establish the winner.
// This package imposes no constraints on participant values.
//
// A leafGTYPE keeps current int value and an alive flag.
type leafGTYPE struct {
	v     GTYPE
	alive bool
}

// [LoserTreeGTYPE] is a tournament tree in which each internal node
// stores the index of the leaf that lost the comparison.
// The overall winner is kept in the winner field.
type LoserTreeGTYPE struct {
	// nodesPtr stores the indices of leaves.
	nodesPtr *Index
	// leavesPtr are the comparison participants.
	leavesPtr *leafGTYPE

	// headers of slices to prevent garbage collection.
	nodesSlice  []Index
	leavesSlice []leafGTYPE

	// winner is the current minimum, exposed to the caller.
	winner Index
}

// InitGTYPE creates a LoserTree from the given values.
// [math.MaxInt] is treated as an ordinary (live) value.
//
// If values is nil or empty, it returns (nil, 0, false).
// Otherwise it returns the [*LoserTreeGTYPE], the index of the winning leaf, and ok.
// Both the [*LoserTreeGTYPE] and the index are meaningful only when ok is true.
//
// InitGTYPE copies the input values and pads the leaves slice with dead entries to
// the smallest power of two not less than len(values).
// The nodes slice is twice as long as the leaves slice.
func InitGTYPE(values []GTYPE) (t *LoserTreeGTYPE, ind Index, ok bool) {
	// ok for identity with the Pop
	if len(values) == 0 {
		return // nil, 0, false
	}

	t = &LoserTreeGTYPE{}

	// len of lt.leaves with sentinels
	ext := nextPowerOfTwo(len(values))

	t.leavesSlice = initLeavesGTYPE(values, ext)
	t.nodesSlice = initNodes(ext)
	winnersSlice := initWinners(t.nodesSlice, ext)

	// unsafe initWinners
	// to avoid bounds checking
	leaves := sliceLeavesGTYPE(t.leavesSlice)
	nodes := sliceNodes(t.nodesSlice)
	winners := sliceNodes(winnersSlice)

	t.leavesPtr = leaves
	t.nodesPtr = nodes

	for p := ext - 1; p >= 1; p-- {
		i, j := *indNode(winners, p*2), *indNode(winners, p*2+1)
		winner, loser := initBattleGTYPE(*indLeafGTYPE(leaves, i), *indLeafGTYPE(leaves, j), i, j)

		*indNode(winners, p) = winner
		*indNode(nodes, p) = loser
	}

	t.winner = *indNode(winners, 1)
	return t, t.winner, true
}

// initLeavesGTYPE initializes the leaves slice of tree
// with the given values.
func initLeavesGTYPE(values []GTYPE, ext int) []leafGTYPE {
	leaves := make([]leafGTYPE, ext)

	// values to []leaf
	for i, val := range values {
		leaves[i].v = val
		leaves[i].alive = true
	}

	// fill with sentinels
	for i := len(values); i < ext; i++ {
		leaves[i].v = deadValGTYPE()
	}

	return leaves
}

// Upd sets the value of the current winning leaf to next.
// It does not modify alive.
// It does not update the entire tree; call Pop afterwards to recompute the winner.
//
// Do not call Upd on an exhausted tree (when Pop returned ok == false).
// Upd panics if t is nil.
func (t *LoserTreeGTYPE) Upd(next GTYPE) {
	indLeafGTYPE(t.leavesPtr, t.winner).v = next
}

// Kill replaces the current winning leaf with a sentinel value.
// A killed leaf always loses to any alive leaf.
// After killing, the leaf's value is set to [math.MaxInt] and the leaf is marked as dead.
// A killed leaf cannot be revived.
//
// Kill panics if t is nil.
func (t *LoserTreeGTYPE) Kill() {
	*indLeafGTYPE(t.leavesPtr, t.winner) = leafGTYPE{v: deadValGTYPE()}
}

// Pop updates the tree's winner and the path from the winning leaf to the root.
//
// Before calling Pop, the caller must supply the next value via t.Upd(next) or t.Kill().
//
// If no alive leaf remains, ok is false;
// otherwise ok is true and ind is the index of the winning leaf.
// ind is meaningless when ok is false.
// The caller must check the ok flag before using ind.
//
// Calling Pop twice without Upd/Kill recomputes the same path and returns the same ind.
//
// Pop panics if t is nil.
func (t *LoserTreeGTYPE) Pop() (ind Index, ok bool) {
	leaves := t.leavesPtr
	nodes := t.nodesPtr
	winner := t.winner

	for i := (winner + len(t.leavesSlice)) >> 1; i > 0; i >>= 1 {
		opp := indNode(nodes, i)
		oppI := *opp

		winner, *opp = popBattleGTYPE(
			*indLeafGTYPE(leaves, winner), *indLeafGTYPE(leaves, oppI),
			winner, oppI)
	}

	t.winner = winner
	return winner, indLeafGTYPE(leaves, winner).alive
}

// String formats the tree for debugging.
// Levels are printed from the root (L#0) down; nodes[0] is not used.
func (t *LoserTreeGTYPE) String() string {
	if t == nil {
		return "{<nil LoserTreeGTYPE>}"
	}

	var sb strings.Builder
	sb.Grow(64 + 32*len(t.nodesSlice) + 32*len(t.leavesSlice))

	fmt.Fprint(&sb, "{\nLeaves: {")
	for i, l := range t.leavesSlice {
		if i > 0 {
			fmt.Fprint(&sb, " ")
		}
		fmt.Fprintf(&sb, "(i:%v,v:%v,alive:%v)", i, l.v, l.alive)
	}
	fmt.Fprint(&sb, "};\nNodes: {\n")

	level := 0
	levelStart := 1 // 0th level begin
	for i := 1; i < len(t.nodesSlice); i++ {
		if i == levelStart {
			if i > 1 {
				fmt.Fprint(&sb, "\n")
			}
			fmt.Fprintf(&sb, "L#%v: ", level)
			level++
			levelStart <<= 1
		} else {
			fmt.Fprint(&sb, ",")
		}
		fmt.Fprintf(&sb, "%v", t.nodesSlice[i])
	}
	if len(t.nodesSlice) > 1 {
		fmt.Fprint(&sb, "\n")
	}

	fmt.Fprintf(&sb, "}\nwinner: %v}", t.winner)
	return sb.String()
}
